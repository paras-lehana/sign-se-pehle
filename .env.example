# Sign Se Pehle — environment contract (copy to apps/server/.env for local runs).
# Every variable is optional: with no key the app runs fully in labelled offline mode.

# Gemini API key (Google AI Studio). In production this comes from Secret Manager
# (secret "gemini-api-key", mounted by reference) — never commit a real value.
GEMINI_API_KEY=

# Set to true when GEMINI_API_KEY is a Vertex AI (express mode) key; production uses Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=

# Ordered model failover chain; the first healthy model answers.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# Text-to-speech models for read-aloud, in failover order.
GEMINI_TTS_MODELS=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts

# Per-call timeout for Gemini requests, in milliseconds.
GEMINI_TIMEOUT_MS=45000

# HTTP port (Cloud Run injects PORT=8080).
PORT=8080
